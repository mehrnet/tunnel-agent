{
  "name": "tunnel-agent-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "wrangler dev",
    "prepare:assets": "cp install.sh public/install.sh",
    "deploy": "npm run prepare:assets && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tunnel-agent --local",
    "db:migrate:remote": "wrangler d1 migrations apply tunnel-agent --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.162.0"
  }
}
