# Rathole v0.5.0 pins time 0.3.29, which predates the type-inference changes
# in newer Rust. TrustTunnel at the selected revision instead resolves modern
# Edition 2024 dependencies. Build each with its compatible static toolchain.

FROM rust:1.79-alpine3.20 AS rathole

RUN apk add --no-cache \
    binutils \
    build-base \
    linux-headers \
    openssl-dev \
    openssl-libs-static \
    pkgconf \
    zlib-static

WORKDIR /src/rathole
COPY vendor/rathole /src/rathole

RUN OPENSSL_STATIC=1 PKG_CONFIG_ALL_STATIC=1 \
      cargo build --locked --release \
    && strip --strip-unneeded target/release/rathole

FROM rust:1.100-bookworm AS trusttunnel

# TrustTunnel's BoringSSL bindings are generated by bindgen. A fully static
# musl Rust host cannot dlopen libclang, so this stage is deliberately glibc
# based. Zig provides the native musl C/C++ toolchain used for the final static
# target, while the Rust build script remains able to load libclang.
ARG TARGETARCH
ARG RUST_TARGET
ARG ZIG_VERSION=0.14.0

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        binutils \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libclang-dev \
        nasm \
        perl \
        pkg-config \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN case "$TARGETARCH" in \
        amd64) zig_arch=x86_64; zig_sha=473ec26806133cf4d1918caf1a410f8403a13d979726a9045b421b685031a982 ;; \
        arm64) zig_arch=aarch64; zig_sha=ab64e3ea277f6fc5f3d723dcd95d9ce1ab282c8ed0f431b4de880d30df891e4f ;; \
        *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl --fail --location --silent --show-error \
        --output /tmp/zig.tar.xz \
        "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-${zig_arch}-${ZIG_VERSION}.tar.xz" \
    && echo "${zig_sha}  /tmp/zig.tar.xz" | sha256sum --check --strict \
    && mkdir -p /opt/zig \
    && tar --extract --xz --file /tmp/zig.tar.xz --strip-components=1 --directory /opt/zig \
    && rm /tmp/zig.tar.xz

RUN case "$RUST_TARGET" in \
        x86_64-unknown-linux-musl) zig_target=x86_64-linux-musl ;; \
        aarch64-unknown-linux-musl) zig_target=aarch64-linux-musl ;; \
        *) echo "unsupported Rust target: $RUST_TARGET" >&2; exit 1 ;; \
    esac \
    && rustup target add "$RUST_TARGET" \
    && printf '#!/bin/sh\nexec /opt/zig/zig cc -target %s "$@"\n' "$zig_target" > /usr/local/bin/zig-musl-cc \
    && printf '#!/bin/sh\nexec /opt/zig/zig c++ -target %s "$@"\n' "$zig_target" > /usr/local/bin/zig-musl-cxx \
    && chmod +x /usr/local/bin/zig-musl-cc /usr/local/bin/zig-musl-cxx

ENV CC=/usr/local/bin/zig-musl-cc
ENV CXX=/usr/local/bin/zig-musl-cxx
ENV CMAKE_C_COMPILER=/usr/local/bin/zig-musl-cc
ENV CMAKE_CXX_COMPILER=/usr/local/bin/zig-musl-cxx
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=/usr/local/bin/zig-musl-cc
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=/usr/local/bin/zig-musl-cc

WORKDIR /src/trusttunnel
COPY vendor/trusttunnel /src/trusttunnel

RUN cargo build --locked --release --target "$RUST_TARGET" --bin trusttunnel_endpoint \
    && strip --strip-unneeded "target/${RUST_TARGET}/release/trusttunnel_endpoint"

FROM scratch AS export
ARG RUST_TARGET
COPY --from=rathole /src/rathole/target/release/rathole /rathole
COPY --from=trusttunnel /src/trusttunnel/target/${RUST_TARGET}/release/trusttunnel_endpoint /trusttunnel_endpoint
