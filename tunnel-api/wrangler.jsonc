{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "tunnel-api",
  "account_id": "94eee55a09ab74b34c825f704aa6b4cf",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-13",
  "routes": [
    {
      "pattern": "tunnel-api.mehrnet.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tunnel-agent",
      "database_id": "d6caf939-b959-4471-918f-2e05ca282a37",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "API_ORIGIN": "https://tunnel-api.mehrnet.com",
    "FILES_ORIGIN": "https://tunnel-files.mehrnet.com",
    "TELEGRAM_BOT_USERNAME": "TunnelOwnersBot",
    "ENROLLMENT_TTL_SECONDS": "900",
    "DOMESTIC_CAPSULE_BUNDLE_VERSION": "v0.4.17"
  }
  // Set TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, BUNDLE_PUBLISH_TOKEN,
  // and optionally DOMESTIC_BOOTSTRAP_URL with `wrangler secret put`; no
  // credential belongs in vars, this file, or source control.
}
